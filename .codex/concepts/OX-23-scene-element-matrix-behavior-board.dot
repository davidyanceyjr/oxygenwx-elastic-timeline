digraph OX23Matrix {
  graph [rankdir=TB, bgcolor="#f3f6f8", pad="0.35", nodesep="0.42", ranksep="0.56",
    splines=polyline, fontname="DejaVu Sans", fontsize=19, labelloc=t,
    label="OX-23  |  INVENTORY THE AUTHORABLE SCENE-ELEMENT MATRIX\nBehavior / contract board • cycle 147 • PROPOSED FOR OWNER REVIEW"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11,
    color="#6d8999", fillcolor="#ffffff", fontcolor="#20394b", penwidth=1.2,
    margin="0.16,0.10"];
  edge [color="#587a89", fontname="DejaVu Sans", fontsize=9, arrowsize=0.7];

  deps [fillcolor="#e5eef3", label="COMPLETED INPUT CONTRACTS\nOX-04: evidence and unknown-state meaning\nOX-05: First City Background → Middle-Ground → Foreground order\nOX-06: First City-local identity and role, distinct from draw passes\nOX-18: shared selected-instant SceneWeatherDecision for two worlds"];

  sources [fillcolor="#e5eef3", label="CURRENT SOURCE INTAKE\nFirstCityComposition: 11 semantic objects, depth / local order, pass mapping\nAtmosphericScene: actual draw calls, city bitmap assets, open-landscape primitives\nMinimalOpenLandscapeComposition: shared weather decisions; no typed element inventory"];

  matrix [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#7b98a7">
      <TR><TD COLSPAN="2" BGCOLOR="#cee3e8"><B>ONE SOURCE-LINKED ROW PER MEANINGFUL CURRENT OBJECT</B></TD></TR>
      <TR><TD BGCOLOR="#edf4f6" ALIGN="LEFT"><B>Record now</B></TD><TD ALIGN="LEFT">World, source path / symbol, current identity + role or descriptive label,<BR ALIGN="LEFT"/>depth + local order or “not typed”, draw pass / call, input owner,<BR ALIGN="LEFT"/>bitmap or primitive source, and first-substitution disposition</TD></TR>
      <TR><TD BGCOLOR="#edf4f6" ALIGN="LEFT"><B>City coverage</B></TD><TD ALIGN="LEFT">All 11 OX-06 identities; one CLOUD_COVER row maps to both cloud passes.<BR ALIGN="LEFT"/>TIME_WASH and READOUT_QUIET_ZONE are compositing passes, not objects.</TD></TR>
      <TR><TD BGCOLOR="#edf4f6" ALIGN="LEFT"><B>Open landscape coverage</B></TD><TD ALIGN="LEFT">Sky, cloud field, terrain, left / right tree groups, rain / snow field.<BR ALIGN="LEFT"/>Use descriptive labels; do not invent a typed cross-world ID or depth enum.</TD></TR>
    </TABLE>>];

  candidate [fillcolor="#e2f1e7", color="#5e9474", label="PROPOSED FIRST SUBSTITUTION CANDIDATE\nFirst City CANOPY → VEGETATION → Foreground / CANOPY pass\nDedicated sg2_city_canopy bitmap; drawAlignedLayer(canopy)\nSingle current object and pass make this a bounded future OX-24 candidate.\nOX-23 records the candidate; it does not swap or authorize the asset."];

  defer [fillcolor="#fff1dc", color="#c7a160", label="EXPLICITLY DEFER TO CONSUMERS\nNew declaration/type and ordered-depth implementation → OX-34\nAuthored geometry / anchors → OX-35\nTyped weather input slots and fallback → OX-36\nAdapter, asset swap, second-world reuse → OX-38 / OX-24 / OX-92\nPack manifest, hit metadata, and universal registry are not OX-23 outputs"];

  exit [fillcolor="#dcebe5", color="#5b9479", label="OX-23 EXIT RECORD\nSource-linked matrix + actual candidate object / asset / pass\nTrace OX-05, OX-06, OX-18 contracts and mark deferred fields\nNo code change, visual change, new weather interpretation, or installed acceptance claim"];

  deps -> matrix [label="constraints"];
  sources -> matrix [label="verify actual ownership"];
  matrix -> candidate [label="bounded candidate"];
  matrix -> defer [label="field disposition"];
  candidate -> exit;
  defer -> exit;
}
